set.seed(123)
options(digits = 3, scipen = 999)
library(readxl)
library(dplyr)
library(radiant.data)
library(visreg)
library(texreg)
library(clarify)
setwd ("C:/Users/Yung Cho/Documents/GitHub/Yung_QC")
data16 <- read_xlsx("ANES 2016.xlsx", sheet = 2)
data16 <- data16 %>%
mutate(vote16 = ifelse(vote16 == 2, 1, 0)) %>%  # Trump = 1, Clinton & Other = 0
mutate(education_cat = case_when(
education == 0 ~ "Less High School",
education == 1 ~ "High School",
education == 2 ~ "College Degree",
education == 3 ~ "Graduate School",
TRUE ~ NA_character_  # Handle unexpected values
)) %>%
select(vote16, religious, education, education_cat, age.group, feel.poor, everything())
data16 <- na.omit(data16)
vote16_breakdown <- data16 %>%
count(vote16) %>%
mutate(percentage = n / sum(n) * 100)
vote16_breakdown
# This analysis examines data from the 2016 American National Election Study (ANES)
# The dependent variable (vote16) is coded as:
# 0 = Voted for Clinton or Independent (56.1% of respondents)
# 1 = Voted for Trump (43.9% of respondents)
# Main predictors include:
# religious: Measure of religiosity 0 = No, 1 = Yes
# education: 0 = Less than High School, 1 = High School, 2 = College Degree, 3 = Graduate School
# age.group: Age category of respondent 1 = 18 - 20, 2 = 21 - 24, 3 = 25 - 29, 4 = 30 - 34, 5 = 35 - 39, 6 = 40 - 44, 7 = 45 - 49, 8 = 50 - 54, 9 = 55 - 59, 10 = 60 - 64, 11 = 65 - 69, 12 = 70 - 84, 13 = 75+
# feel.poor: Feelings about poverty/economic anxiety 0 = Fully Cold 100 = Fully Warm
View(vote16_breakdown)
View(data16)
View(vote16_breakdown)
lm0 <- lm(vote16 ~ religious + education + age.group + feel.poor, data = data16)
summary(lm0)
# Religious: Negative effect (-) on voting for Clinton/Independent
# This suggests more religious voters were more likely to vote for Trump
# Education: Positive effect (+) on voting for Clinton/Independent
# Higher education levels correlate with higher likelihood of voting for Clinton
# Age.group: Negative effect (-) on voting for Clinton/Independent
# Older voters were more likely to support Trump
# Feel.poor: Positive effect (+) on voting for Clinton/Independent
# Significant predictors (p-value < 0.05) suggest a meaningful relationship with the outcome variable.
visreg::visreg(lm0, "religious", scale = "response", rug = FALSE)
# The visreg plot visualizes the relationship between religiosity and the predicted probability of voting for Trump.
# The slope of the line indicates whether religiosity increases or decreases the likelihood of voting for Trump.
lm1 <- lm(vote16 ~ religious + education * feel.poor + age.group, data = data16)
summary (lm1)
# Adding the interaction between education and feel.poor
# The interaction term (`education:feel.poor`) shows how the effect of education on voting changes based on feelings toward poverty.
# Significant interaction terms suggest that the relationship between education and voting is moderated by feelings toward poverty.
htmlreg(list(lm0, lm1), doctype = FALSE)
# The table compares the two linear models (lm0 and lm1).
# Model 0 (lm0): Includes main effects only.
# Model 1 (lm1): Adds an interaction term between education and feelings toward poverty.
# The table allows for easy comparison of coefficients, standard errors, and significance levels.
nlm0 <- glm(vote16 ~ religious + education + age.group + feel.poor, family = binomial, data = data16)
summary(nlm0)
# The summary of nlm0 provides coefficients for the logistic regression model.
# Coefficients represent the log-odds of voting for Trump for each predictor.
# Significant predictors (p-value < 0.05) indicate a strong relationship with the outcome variable.
# Coefficients represent log-odds of voting for Clinton/Independent
# Direction of effects matches the linear model, but scale differs
# The model confirms religiosity (-) and age (-) decrease likelihood of voting for Clinton while education (+) and feel.poor (+) increase it
nlm1 <- glm(vote16 ~ religious + education * feel.poor + age.group, family = binomial, data = data16)
summary(nlm1)
# The summary of nlm1 includes an interaction term between education and feelings toward poverty.
# The interaction term shows how the effect of education on voting changes based on feelings toward poverty.
# Significant interaction terms suggest a moderating effect.
nlm2 <- glm(vote16 ~ religious + education * feel.poor + age.group + I(feel.poor^2), family = binomial, data = data16)
summary(nlm2)
# Adds squared term for age.group to capture potential non-linear relationship
# Tests whether age's effect follows a curved rather than straight-line pattern
# If significant, suggests that middle-aged voters might behave differently than both younger and older voters
htmlreg(list(nlm0, nlm1, nlm2), doctype = FALSE)
# The table compares the three logistic regression models (nlm0, nlm1, nlm2).
# Model 0 (nlm0): Includes main effects only.
# Model 1 (nlm1): Adds an interaction term between education and feelings toward poverty.
# Model 2 (nlm2): Adds a quadratic term for age.group.
# The table highlights differences in coefficients, standard errors, and model fit.
sim_coefs <- sim(nlm0)
sim_est <- sim_ame(sim_coefs, var = "religious",
contrast = "rd", verbose = FALSE)
summary(sim_est)
# The summary of sim_est shows the average marginal effects of religiosity on voting.
# The `contrast = "rd"` option calculates risk differences (probability differences).
# Significant effects indicate that religiosity has a meaningful impact on voting behavior.
plot(sim_est)
# The plot visualizes the marginal effects of religiosity on voting.
# The y-axis shows the change in probability of voting for Trump.
# The x-axis represents the range of religiosity values.
View(sim_coefs)
sim_est1 <- sim_ame(sim_coefs, var = "education_cat",
contrast = "rd", verbose = FALSE)
education_breakdown <- data16 %>%
count(education_cat) %>%
mutate(percentage = n / sum(n) * 100)
View(education_breakdown)
nlm3 <- glm(vote16 ~ religious + education_cat + feel.poor + age.group , family = binomial, data = data16)
summary(nlm3)
nlm3 <- glm(vote16 ~ education_cat, family = binomial, data = data16)
summary(nlm3)
sim_nlm3 <- sim(nlm3)
sim_edu_cat <- sim_ame(sim_nlm3, var = "education_cat",
contrast = "rd", verbose = FALSE)
summary(sim_edu_cat)
summary(nlm3)
sim_nlm3 <- sim(nlm3)
sim_edu_cat <- sim_ame(sim_nlm3, var = "education_cat",
contrast = "rd", verbose = FALSE)
nlm3 <- glm(vote16 ~ religious + education_cat * feel.poor + age.group, family = binomial, data = data16)
nlm3 <- glm(vote16 ~ religious + education_cat * feel.poor + age.group, family = binomial, data = data16)
nlm3 <- glm(vote16 ~ religious + education_cat + feel.poor + age.group, family = binomial, data = data16)
summary(nlm3)
sim_nlm3 <- sim(nlm3)
sim_edu_cat <- sim_ame(sim_nlm3, var = "education_cat",
contrast = "rd", verbose = FALSE)
summary(sim_edu_cat)
data16$education_cat <- factor(data16$education_cat,
levels = c("< High School",
"High School",
"College Degree",
"Graduate School"))
education_breakdown <- data16 %>%
count(education_cat) %>%
mutate(percentage = n / sum(n) * 100)
education_breakdown
data16$education_cat <- factor(data16$education_cat,
levels = c("Less High School",
"High School",
"College Degree",
"Graduate School"))
education_breakdown <- data16 %>%
count(education_cat) %>%
mutate(percentage = n / sum(n) * 100)
education_breakdown
rm(list=ls())
