library(readxl)
library(dplyr)
library(radiant.data)
library(visreg)
library(texreg)
library(clarify)
setwd ("C:/Users/Yung Cho/Documents/GitHub/Yung_QC")
data16 <- read_xlsx("ANES 2016.xlsx", sheet = 2)
data16 <- data16 %>%
mutate(vote16 = ifelse(vote16 == 2, 1, 0)) %>%  # Trump = 1, Clinton & Other = 0
mutate(education_cat = case_when(
education == 0 ~ "Less High School",
education == 1 ~ "High School",
education == 2 ~ "College Degree",
education == 3 ~ "Graduate School",
TRUE ~ NA_character_  # Handle unexpected values
)) %>%
select(vote16, religious, education, education_cat, age.group, feel.poor, everything())
data16 <- na.omit(data16)
vote16_breakdown <- data16 %>%
count(vote16) %>%
mutate(percentage = n / sum(n) * 100)
vote16_breakdown
education_breakdown <- data16 %>%
count(education_cat) %>%
mutate(percentage = n / sum(n) * 100)
education_breakdown
View(vote16_breakdown)
lm0 <- lm(vote16 ~ religious + education_cat + age.group + feel.poor, data = data16)
summary(lm0)
# Religious: Negative effect (-) on voting for Clinton/Independent
# This suggests more religious voters were more likely to vote for Trump
# Education: Positive effect (+) on voting for Clinton/Independent
# Higher education levels correlate with higher likelihood of voting for Clinton
# Age.group: Negative effect (-) on voting for Clinton/Independent
# Older voters were more likely to support Trump
# Feel.poor: Positive effect (+) on voting for Clinton/Independent
# Significant predictors (p-value < 0.05) suggest a meaningful relationship with the outcome variable.
visreg::visreg(lm0, "religious", scale = "response", rug = FALSE)
# The visreg plot visualizes the relationship between religiosity and the predicted probability of voting for Trump.
# The slope of the line indicates whether religiosity increases or decreases the likelihood of voting for Trump.
View(education_breakdown)
lm0 <- lm(vote16 ~ religious + education_cat + age.group, data = data16)
summary(lm0)
# Religious: Negative effect (-) on voting for Clinton/Independent
# This suggests more religious voters were more likely to vote for Trump
# Education: Positive effect (+) on voting for Clinton/Independent
# Higher education levels correlate with higher likelihood of voting for Clinton
# Age.group: Negative effect (-) on voting for Clinton/Independent
# Older voters were more likely to support Trump
# Feel.poor: Positive effect (+) on voting for Clinton/Independent
# Significant predictors (p-value < 0.05) suggest a meaningful relationship with the outcome variable.
visreg::visreg(lm0, "religious", scale = "response", rug = FALSE)
# The visreg plot visualizes the relationship between religiosity and the predicted probability of voting for Trump.
# The slope of the line indicates whether religiosity increases or decreases the likelihood of voting for Trump.
lm0 <- lm(vote16 ~ religious + education + age.group + feel.poor, data = data16)
summary(lm0)
# Religious: Negative effect (-) on voting for Clinton/Independent
# This suggests more religious voters were more likely to vote for Trump
# Education: Positive effect (+) on voting for Clinton/Independent
# Higher education levels correlate with higher likelihood of voting for Clinton
# Age.group: Negative effect (-) on voting for Clinton/Independent
# Older voters were more likely to support Trump
# Feel.poor: Positive effect (+) on voting for Clinton/Independent
# Significant predictors (p-value < 0.05) suggest a meaningful relationship with the outcome variable.
visreg::visreg(lm0, "religious", scale = "response", rug = FALSE)
# The visreg plot visualizes the relationship between religiosity and the predicted probability of voting for Trump.
# The slope of the line indicates whether religiosity increases or decreases the likelihood of voting for Trump.
rm(list = LS())
