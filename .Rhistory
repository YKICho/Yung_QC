lr_test
# Fit the models with different number of predictors
model_0 <- lm(weight ~ 1, data = chic_data)
model_1 <- lm(weight ~ Time, data = chic_data)
model_2 <- lm(weight ~ Time + Chick, data = chic_data)
# Calculate AIC and BIC for each model
AIC_calc <- AIC(model_0, model_1, model_2)
BIC_calc <- BIC(model_0, model_1, model_2)
