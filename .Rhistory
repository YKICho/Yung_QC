# The test statistics is calculated at the ratio of the maximum likelihood of the data under the null hypothesis to the maximum likelihood under the alternative hypothesis.
# Fit the full model (including Diet)
full_model <- lm(weight ~ Time + Diet, data = chic_data)
# Fit the reduced model (excluding Diet)
reduced_model <- lm(weight ~ Time, data = chic_data)
# Perform the likelihood ratio test
lr_test <- lrtest(full_model, reduced_model)
print(lr_test)
# Fit the models with different number of predictors
model_0 <- lm(weight ~ 1, data = chic_data)
model_1 <- lm(weight ~ Time, data = chic_data)
model_2 <- lm(weight ~ Time + Chick, data = chic_data)
# Calculate AIC and BIC for each model
AIC_calc <- AIC(model_0, model_1, model_2)
BIC_calc <- BIC(model_0, model_1, model_2)
# Compare the AIC and BIC values
values <- data.frame(
Model = c("Weight", "+ Time", "+ Diet"),
AIC = AIC_calc$AIC,
BIC = BIC_calc$BIC
)
print(values)
# The AIC and BIC values are used to compare the goodness of fit between models with different numbers of predictors. Lower values indicate a better fit. In this case, the model with the lowest AIC and BIC values is the model with both Time and Diet as predictors. This suggests that the model with both predictors provides the best fit to the data.
# Fit the models with different number of predictors
model_0 <- lm(weight ~ 1, data = chic_data)
model_1 <- lm(weight ~ Time, data = chic_data)
model_2 <- lm(weight ~ Time + Diet, data = chic_data)
# Calculate AIC and BIC for each model
AIC_calc <- AIC(model_0, model_1, model_2)
BIC_calc <- BIC(model_0, model_1, model_2)
# Compare the AIC and BIC values
values <- data.frame(
Model = c("Weight", "Weight + Time", "Weight + Time + Diet"),
AIC = AIC_calc$AIC,
BIC = BIC_calc$BIC
)
print(values)
# The Akaike Information Criterion (AIC) is the lowest for Model 2, which includes both Time and Diet as predictors. The Bayesian Information Criterion (BIC) is also the lowest for Model 2. This suggests that the model with both predictors provides the best fit to the data.
