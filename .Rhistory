values <- data.frame(
Model = c("Weight", "+ Time", "+ Diet"),
AIC = AIC_calc,
BIC = BIC_calc
)
print(values)
# Define the log-likelihood function for the linear model
logLik_lm <- function(param) {
beta <- param[1:2]
sigma <- param[3]
y <- chic_data$weight
X <- cbind(1, chic_data$Time)
mu <- X %*% beta
ll <- sum(dnorm(y, mean = mu, sd = sigma, log = TRUE))
return(ll)
}
# Initial parameter estimates
start_params <- c(beta0 = 1, beta1 = 1, sigma = 1)
# Perform MLE using maxLik
mle_result <- maxLik(logLik = logLik_lm, start = start_params)
summary(mle_result)
